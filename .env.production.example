# 复制为 .env.production，并替换所有 CHANGE_ME 值；不要提交真实文件。
# 本地 HTTP Docker 演示使用 localhost:8080 且关闭 Secure Cookie。
# 正式部署请改为真实 HTTPS 域名，并将 JOBTRACK_COOKIE_SECURE 设为 true。
MYSQL_DATABASE=jobtrack
MYSQL_USER=jobtrack
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

REDIS_PASSWORD=CHANGE_ME_redis_password
JWT_SECRET=CHANGE_ME_use_at_least_32_random_bytes_here
JOBTRACK_FRONTEND_ORIGIN=http://localhost:8080
JOBTRACK_COOKIE_SECURE=false
SPRINGDOC_ENABLED=false
TZ=Asia/Shanghai
WEB_PORT=8080
