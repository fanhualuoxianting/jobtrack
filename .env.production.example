# 复制为 .env.production，并替换所有 CHANGE_ME 值；不要提交真实文件。
MYSQL_DATABASE=jobtrack
MYSQL_USER=jobtrack
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

REDIS_PASSWORD=CHANGE_ME_redis_password
JWT_SECRET=CHANGE_ME_use_at_least_32_random_bytes_here
JOBTRACK_FRONTEND_ORIGIN=http://localhost
JOBTRACK_COOKIE_SECURE=false
SPRINGDOC_ENABLED=false
TZ=Asia/Shanghai

DB_HOST=mysql
DB_PORT=3306
DB_NAME=jobtrack
DB_USERNAME=jobtrack
DB_PASSWORD=CHANGE_ME_database_password
REDIS_HOST=redis
REDIS_PORT=6379
FILE_STORAGE_ROOT=/app/data/uploads
